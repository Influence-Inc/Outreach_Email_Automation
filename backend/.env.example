# Server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# --- Dashboard access: Sign in with Slack ----------------------------------
# The Deal Studio dashboard is internal-only. Instead of a shared password, team
# members sign in with their Slack account (Slack's OpenID Connect flow). When
# SLACK_CLIENT_ID + SLACK_CLIENT_SECRET are set, the dashboard, its assets and
# every admin /api/* route require a Slack session cookie (30 days; GET /logout
# clears it).
#
# Set-up (once), at https://api.slack.com/apps → your app:
#   1. "OAuth & Permissions" → Redirect URLs → add {this backend origin}
#      /auth/slack/callback  (e.g. https://<your-app>.up.railway.app/auth/slack/callback).
#      NOTE: this must be THIS backend's own URL, not campaigns.influence.technology
#      (the proxy only forwards creator pages), which is also why PUBLIC_BASE_URL
#      is not reused for it. Set SLACK_REDIRECT_URI below if auto-detection from
#      the request isn't right for your setup.
#   2. "OpenID Connect" (or add the openid, email, profile user scopes) → enable
#      "Sign in with Slack".
#   3. Copy the Client ID + Client Secret from "Basic Information".
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional but STRONGLY recommended: lock sign-in to your own workspace and/or
# email domain — otherwise ANY Slack account can sign in (boot logs a warning).
# SLACK_ALLOWED_TEAM_ID is your workspace's team id (starts with "T…"; find it at
# https://<workspace>.slack.com/admin or in the URL). Both accept a comma list.
SLACK_ALLOWED_TEAM_ID=
SLACK_ALLOWED_EMAIL_DOMAINS=useinfluence.xyz
# Optional. Exact OAuth redirect URI. Leave blank to derive it from the incoming
# request; set it to pin the value (must match the Redirect URL registered above).
SLACK_REDIRECT_URI=
# Optional. Session + OAuth-state tokens are signed with a key derived from
# SLACK_CLIENT_SECRET, so rotating the Slack secret logs everyone out. Set this to
# a fixed random string to keep sessions alive across a secret rotation instead.
SITE_SESSION_SECRET=
# Optional machine credential for HEADLESS clients that have no Slack session at
# all (curl, cron scripts). When set, requests may authenticate with
# `x-api-token: <DASHBOARD_API_TOKEN>` (the legacy `x-site-password` header and
# HTTP Basic — any username — also work). Only honoured while Slack sign-in is on.
# Pick something long and random, e.g. `openssl rand -base64 24`.
# NOTE: the Chrome extension does NOT need this — it reuses the signed-in team
# member's dashboard session (reads the io_session cookie and forwards it as the
# x-io-session header), so there's nothing to configure in the extension.
DASHBOARD_API_TOKEN=
#
# Surfaces that stay OPEN either way (resolved by unguessable token or their own
# secret): /contract/:token, /contracts/:token, /o/:token, /go/imessage,
# /api/contracts/*, /api/offers/*, /webhook/* (Instantly / Twilio / Meta / Linq),
# /api/bot/* (x-bot-token — OUTREACH_BOT_TOKEN above), /health.
#
# If SLACK_CLIENT_ID / SLACK_CLIENT_SECRET are UNSET the gate is OFF and the
# dashboard is publicly reachable by anyone who knows the URL — boot logs a
# warning saying so. Set them in Railway to switch protection on.

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/influence_outreach

# Scheduler — how often the negotiation poller runs (outreach + follow-ups
# are sent by Instantly on its own schedule).
SCHEDULER_INTERVAL_MINUTES=5

# Pre-send email verification (syntax + DNS/MX). On by default; undeliverable
# scraped addresses are skipped and flagged 'invalid_email' instead of being
# pushed into Instantly. Set EMAIL_VERIFY=0 to disable.
EMAIL_VERIFY=1

# Off-Instagram email enrichment. When a profile has no email anywhere on
# Instagram, follow the creator's OWN links (website + Linktree/bio-hub links
# the extension captured) and scrape a verified contact email off those pages.
# Free + best-effort, on by default; set EMAIL_ENRICH=0 to disable the automatic
# fallback during scraping (the explicit POST /api/creators/:id/enrich-email and
# /api/creators/bulk/enrich-email endpoints still run on demand).
EMAIL_ENRICH=1
# Optional paid fallback, tried only when the free web discovery finds nothing.
# Off unless a provider + key are set. Supported values:
#   serper  — web search via serper.dev (set SERPER_API_KEY). Searches the
#             creator's name/handle for their email/contact — YouTube first (most
#             creators publish a business email on their channel About page) —
#             reads an address out of the result snippets, and scrapes the top
#             result pages (YouTube channel/About, company site, press, …),
#             including the channel's /about tab. Works even when the creator has
#             no site or link in bio. Only keeps an address that carries the
#             creator's own name/handle. Get a key at https://serper.dev.
#   hunter  — api.hunter.io email-finder (set HUNTER_API_KEY). Looks up a mailbox
#             on a specific domain, so it only runs when the creator has a site.
# Leave EMAIL_ENRICH_PROVIDER blank to never make a paid call.
EMAIL_ENRICH_PROVIDER=serper
SERPER_API_KEY=
HUNTER_API_KEY=

# Per-creator pacing between bulk lead-add calls to Instantly (ms). Jittered ±20%.
SEND_PACING_MS=60000

# Signatory shown in outreach + follow-up email bodies (the {SENDER_NAME}
# substitution in the built-in templates). Also used as a fallback for
# MANAGER_NAME if that isn't set.
SENDER_NAME=Jennifer

# Upstream brands + campaigns source
# GET https://campaigns.influence.technology/api/bot/campaigns with x-bot-token header
CAMPAIGNS_API_BASE=https://campaigns.influence.technology
CAMPAIGNS_API_TOKEN=

# Optional: Instagram sessionid cookie from Jennifer's logged-in browser.
# Required to read business_email (the "Email" button data) for most profiles.
# Get it from Chrome: DevTools -> Application -> Cookies -> instagram.com -> sessionid
IG_SESSION_COOKIE=

# --- Instantly.ai (email sender) ------------------------------------------
# All outreach, follow-ups, and negotiation replies go through Instantly.
# API key from https://app.instantly.ai/app/settings/integrations
INSTANTLY_API_KEY=
# Fallback Instantly campaign UUID. Each dashboard campaign can set its own
# Instantly campaign ID (Campaign settings → "Instantly campaign ID") so every
# brand uses its own outreach copy + follow-up sequence. This env value is used
# only for campaigns that haven't been mapped. Copy a UUID from the campaign URL
# in the Instantly dashboard.
INSTANTLY_CAMPAIGN_ID=
# HMAC secret to verify Instantly webhook signatures. Set this in the
# Instantly webhook config to reject forged payloads.
#
# Point the Instantly webhook at POST {PUBLIC_BASE_URL}/webhook/instantly and
# subscribe to BOTH events:
#   • Reply Received  — drives reply detection → negotiation (status: replied)
#   • Email Sent      — advances the dashboard from "outreach sent" to
#                       "follow up sent" when Instantly sends a follow-up step.
# Without the Email Sent event the status stays on "outreach sent" even after
# the follow-up goes out.
INSTANTLY_WEBHOOK_SECRET=
# Optional: per-request timeout for Instantly API calls (ms). Default 15000.
INSTANTLY_TIMEOUT_MS=
# Optional fallback sending mailbox (eaccount) for threaded negotiation replies.
# Normally the mailbox is captured automatically from each reply webhook
# (email_account). This is only used for replies received before that field was
# stored. Must be a connected Instantly account, e.g. jennifer@frominfluence.com
INSTANTLY_EACCOUNT=

# --- Creator negotiation ---------------------------------------------------
# Claude is used ONLY to (a) understand plain-text replies and (b) write the
# emails. Offer numbers are 100% formula (see pricing.js).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Pricing formula constants. effectiveCpm = TARGET_CPM * (1 - RISK_BUFFER).
TARGET_CPM=15
RISK_BUFFER=0.20
BONUS_PERCENTAGE=0.20
NUM_VIDEOS=2

# Admin approval gate: no offer email sends until an admin approves an offer.
REQUIRE_OFFER_APPROVAL=true

# Negotiation follow-ups: bump after N idle days, at most this many, then CLOSED.
NEGOTIATION_FOLLOWUP_DAYS=2
NEGOTIATION_MAX_FOLLOWUPS=2

# USED-creator messaging invite: if an invited creator never engages (no "Hi",
# no reply), send ONE reminder email after this many hours. 0 / blank disables it.
USED_INVITE_FOLLOWUP_HOURS=32

# Pending-offer reminder: if a creator receives an offer and hasn't accepted or
# declined it, send ONE nudge over their established messaging channel after
# this many hours have passed since the offer was created, provided the offer
# still has at least OFFER_REMINDER_MIN_EXPIRY_MARGIN_HOURS to run before it
# expires. Set to 0 / blank to disable the sweep entirely.
OFFER_REMINDER_AFTER_HOURS=24
OFFER_REMINDER_MIN_EXPIRY_MARGIN_HOURS=6
# How often (minutes) the reminder sweep runs (default hourly; 0 disables).
OFFER_REMINDERS_SWEEP_MINUTES=60

# How often (minutes) to sweep the campaign dashboard for creators who've completed
# all their deliverables and send each a one-time "graduation" email inviting them
# onto WhatsApp/iMessage for future collabs. Needs RESEND + CAMPAIGNS_API_TOKEN +
# a business messaging number configured. 0 / blank disables the sweep.
GRADUATION_SWEEP_MINUTES=60

# Kill-switch for the one-time "graduation" email itself. PAUSED by default in
# code right now — no graduation emails are sent regardless of the sweep interval
# above. Set to false to resume sending; any other / unset value keeps it paused.
GRADUATION_EMAILS_PAUSED=true

# Brand / manager / posting cadence. The campaign's own brand_name wins over
# BRAND_NAME. MANAGER_NAME is the signatory shown in negotiation emails.
BRAND_NAME=
MANAGER_NAME=Jennifer
# Posting cadence / timeline guidance, e.g. "1-2 videos per week". Claude (or
# the deterministic fallback) derives an approximate "all videos posted by"
# date from this cadence + today's date + the number of videos in the deal —
# it is NOT a literal date. CONTENT_CADENCE wins if both are set.
CAMPAIGN_DEADLINE=1-2 videos per week
CONTENT_CADENCE=

# --- Continuous reply learning ---------------------------------------------
# The negotiation model "learns" by collecting labeled (creator inbound →
# manager reply) pairs into the reply_examples table and replaying the most
# relevant ones as few-shot examples in every Claude prompt. Two feeds:
#
# 1. Delegate replies — every reply a human sends from the Delegate window is
#    labeled and stored immediately, so the same doubt/question stops landing
#    in the Delegate queue. Set LEARN_FROM_DELEGATE=0 to disable.
LEARN_FROM_DELEGATE=1
# 2. Mailbox harvest — every LEARN_HARVEST_HOURS the scheduler sweeps the
#    connected mailbox (jennifer@useinfluence.xyz) through the Instantly API,
#    pairs each creator message with the next manager reply, labels the pair
#    with Claude, and stores it. 0 disables the scheduled sweep (the manual
#    `npm run learn:harvest` CLI still works).
LEARN_HARVEST_HOURS=24
# Cap on mailbox emails scanned per harvest run (newest first).
LEARN_HARVEST_MAX_EMAILS=500
# The mailbox address whose messages count as "ours" when pairing threads.
# Falls back to INSTANTLY_EACCOUNT when unset.
SENDER_EMAIL=jennifer@useinfluence.xyz

# --- Creator Contracts -----------------------------------------------------
# When a creator accepts, a unique contract is generated and emailed as
# {PUBLIC_BASE_URL}/contract/{token} (PUBLIC_BASE_URL is set at the top of this
# file). In production, set PUBLIC_BASE_URL=https://campaigns.influence.technology
# — that service proxies /contract/:token, /contract.js and /api/contracts/*
# straight through to this backend (see its OUTREACH_BASE_URL env var), so the
# link the creator gets carries the campaigns.influence.technology domain while
# this backend still does all the actual work. This backend also still serves
# /contract/:token (and the legacy /contracts/:token) directly, so a bare
# PUBLIC_BASE_URL pointing at this service's own origin works too (e.g. local
# dev, or if the proxy isn't set up yet).
#
# Creator Database sync: after a contract is signed the creator + contract are
# pushed to the Creator-Database service (which dedups by email → instagram →
# name). CREATOR_DB_URL is that service's base URL; leave blank to disable the
# sync (the signature still records locally and a scheduler pass can retry).
# CREATOR_DB_API_KEY must match the Creator DB's INTERNAL_API_KEY — it's sent as
# the x-api-key header.
# To backfill contracts that were signed BEFORE this was configured, either:
#   • run once:  npm run sync:contracts           (add --dry-run to preview), or
#   • trigger over HTTP (no shell needed):
#       POST /api/bot/sync-contracts?dryRun=true   with x-bot-token: OUTREACH_BOT_TOKEN
#     (drop dryRun to actually push). Set OUTREACH_BOT_TOKEN to use this route.
CREATOR_DB_URL=
CREATOR_DB_API_KEY=
# Optional: per-request timeout for Creator-DB calls (ms). Default 15000.
CREATOR_DB_TIMEOUT_MS=

# Campaign dashboard sync: after a contract is signed, the creator + agreed
# deliverables/deadline are pushed to the campaign dashboard (influence-stats)
# as a new row (or an update to an existing one). CAMPAIGN_DASHBOARD_URL is
# that service's base URL; leave blank to disable the sync (the signature
# still records locally and a backfill can retry). No campaign-id mapping is
# needed — campaigns are already synced FROM the dashboard (see
# CAMPAIGNS_API_BASE above), so creator.campaign_id already matches the
# dashboard's own campaign id.
# CAMPAIGN_DASHBOARD_API_KEY must match the dashboard's DEAL_STUDIO_API_KEY —
# it's sent as the x-api-key header.
# To backfill contracts that were signed BEFORE this was configured, either:
#   • run once:  npm run sync:dashboard           (add --dry-run to preview), or
#   • trigger over HTTP (no shell needed):
#       POST /api/bot/sync-contracts-to-dashboard?dryRun=true   with x-bot-token: OUTREACH_BOT_TOKEN
#     (drop dryRun to actually push). Set OUTREACH_BOT_TOKEN to use this route.
CAMPAIGN_DASHBOARD_URL=
CAMPAIGN_DASHBOARD_API_KEY=
# Optional: per-request timeout for campaign-dashboard calls (ms). Default 15000.
CAMPAIGN_DASHBOARD_TIMEOUT_MS=

# --- Bot API auth (inbound) -----------------------------------------------
# Shared secret that protects the /api/bot/* endpoints — used by the campaigns
# dashboard (influence-stats) to fetch per-creator contract URLs for the
# "Contract submission" column. Set to a random string and mirror it as
# OUTREACH_BOT_TOKEN on the influence-stats service. If unset the bot endpoints
# return 503.
OUTREACH_BOT_TOKEN=

# Set to 1/true to log negotiation emails instead of sending them (dry-run).
DRY_RUN=

# --- Offer Portal (old-creator negotiation) -------------------------------
# "Old" creators (those who already did a DIFFERENT campaign, per the Creator
# Database) negotiate on a hosted offer page / over WhatsApp+iMessage instead of
# over email. We never cold-push a WhatsApp/iMessage message — a fresh offer
# sends only an INVITE email ("text Hi to this number to continue"); the offer's
# actual details go out as a free-form reply the moment the creator texts us,
# and every later offer/counter in that negotiation stays on that same channel
# (creators.established_channel). This sidesteps WhatsApp's 24h template
# requirement and iMessage cold-outreach entirely, since nothing is ever sent
# before the creator initiates contact. If a creator has no usable WhatsApp/
# iMessage channel (opted out, no number on file, or a vendor isn't configured
# below), they fall back to the full offer email with the direct web link
# instead, built from PUBLIC_BASE_URL (set at the top of this file) as
# {PUBLIC_BASE_URL}/o/{token}.
#
# Every channel below skips gracefully when its key is absent, so the flow is
# safe to run partially configured (e.g. WhatsApp only). All are replicated from
# the Influence-CDB-portal offer system.

# Email channel — transactional offer + confirmation emails via Resend's REST
# API (no SDK dependency). Also carries the executed-contract copy that goes to
# the creator (with the signed PDF attached) the moment they sign — with no key
# set, the signing flow still completes and the scheduler retries the copy for
# 14 days once a key appears. Leave RESEND_API_KEY blank to skip email sends.
RESEND_API_KEY=
# From address for offer-portal emails. Falls back to EMAIL_FROM, then a default.
OFFER_EMAIL_FROM=INFLUENCE <offers@useinfluence.xyz>
# From address for executed-agreement copies ONLY (the signed contract / portal
# agreement PDF a creator gets when they sign). Its own setting so contract
# replies land with the contract team, not offer outreach. MUST be a Resend-
# verified sender: contracts@useinfluence.xyz is verified as its own sender and
# is the default — override this only if the address ever has to change.
CONTRACT_EMAIL_FROM=INFLUENCE Contracts <contracts@useinfluence.xyz>

# WhatsApp provider selector. 'cloud' = Meta WhatsApp Cloud API DIRECT (no BSP
# markup); 'twilio' = Twilio BSP. Leave BLANK to auto-detect: 'cloud' when
# WHATSAPP_CLOUD_ACCESS_TOKEN is set, else 'twilio'. Set explicitly to force one.
WHATSAPP_PROVIDER=
#
# --- Meta WhatsApp Cloud API (direct) -------------------------------------
# Send: POST {BASE}/{VERSION}/{PHONE_NUMBER_ID}/messages with Authorization:
# Bearer {ACCESS_TOKEN}. Inbound + delivery statuses arrive at your webhook
# (GET verifies with VERIFY_TOKEN, POST is signed X-Hub-Signature-256 with the
# App Secret). Get these from developers.facebook.com → your App → WhatsApp:
#   WHATSAPP_CLOUD_PHONE_NUMBER_ID  — API Setup → the phone number's ID (NOT the
#                                     number itself).
#   WHATSAPP_CLOUD_ACCESS_TOKEN     — a permanent System-User token (Business
#                                     Settings → System Users) with
#                                     whatsapp_business_messaging permission.
#   WHATSAPP_CLOUD_DISPLAY_NUMBER   — the number in E.164 (+…), shown to creators
#                                     in the invite email. Display only.
#   WHATSAPP_CLOUD_VERIFY_TOKEN     — any random string you also paste into Meta's
#                                     webhook "Verify token" field.
#   WHATSAPP_CLOUD_APP_SECRET       — App → Settings → Basic → App Secret.
# Webhook to register in Meta (WhatsApp → Configuration → Webhook):
#   Callback URL: {PUBLIC_BASE_URL}/webhook/whatsapp   Subscribe field: messages
#
# Creator texted "Hi" and heard nothing back? An inbound message only gets a
# reply when its sender matches a creators row (creators.whatsapp) AND the send
# credentials are present — a miss on either is a silent no-op by design. To see
# which one it is, without sending anything:
#   GET /api/debug/messaging-inbound?phone=+919812345670
# (dashboard-authenticated, like the other /api/debug routes). It reports the
# matched creator, how it matched, whether the channel can send, and what the bot
# would reply with. GET /api/debug/offer-portal-config shows channel wiring only.
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_DISPLAY_NUMBER=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
# Optional Graph API base + version overrides (defaults https://graph.facebook.com, v21.0).
WHATSAPP_CLOUD_API_BASE=
WHATSAPP_CLOUD_API_VERSION=
#
# --- Campaign updates for signed creators (WhatsApp) ----------------------
# The messaging lane that starts at a creator's FIRST signed contract and runs
# through the campaign: their content brief, draft-review outcomes, brand
# feedback, post confirmations, and the wrap-up when deliverables are complete.
# See services/creatorUpdates.js. Nothing below is required — with none of it
# set, updates still reach any creator whose 24h WhatsApp window is open, and
# queue in the creator_updates table for the rest.
#
# THE 24h WINDOW, AND WHY TEMPLATES EXIST. WhatsApp only permits free-form text
# to someone who messaged you in the last 24 hours. Campaign updates happen
# outside that window by nature (a brief published Tuesday, an approval Friday),
# so to reach a creator who has gone quiet we need a TEMPLATE: copy submitted to
# Meta in advance and approved by them, which may be sent at any time.
#
# Each var below names an approved template for one kind of update. The copy
# lives in WhatsApp Manager (Meta Business Suite → WhatsApp Manager → Message
# templates), NOT here — these are just the names, so the copy can be edited and
# re-approved without a deploy. A kind with no template set simply waits for the
# creator's window to open instead of failing.
#
# TEMPLATE BODIES must take exactly two positional variables, in this order:
#     {{1}} = the creator's first name        {{2}} = the brand name
# e.g.  "Hi {{1}}, your {{2}} content brief is ready."
# A mismatched variable count is rejected by Meta at send time (error 132000).
#
# URL BUTTONS. Three kinds carry a link (brief_ready → the brief,
# review_approved → the submit-posts form, review_feedback → the review chat).
# Where the approved template has a dynamic URL button, Meta takes only the
# variable SUFFIX of the URL — the fixed prefix is part of the approved template
# — so register the button as e.g. https://your-domain.com/{{1}} and the code
# fills in the rest of the path.
WHATSAPP_TEMPLATE_LANG=
# Asks a newly-signed creator to send us a "Hi" — the inbound that opens the
# window for everything else. Without it that ask goes out by email instead,
# carrying a wa.me deep link that prefills "Hi".
WHATSAPP_TEMPLATE_HI_REQUEST=
WHATSAPP_TEMPLATE_BRIEF_READY=
WHATSAPP_TEMPLATE_REVIEW_SUBMITTED=
WHATSAPP_TEMPLATE_REVIEW_APPROVED=
WHATSAPP_TEMPLATE_REVIEW_FEEDBACK=
WHATSAPP_TEMPLATE_POST_SUBMITTED=
WHATSAPP_TEMPLATE_DELIVERABLES_COMPLETE=
# Re-engagement: a creator who finished a campaign stays subscribed, so the NEXT
# campaign's outreach opens in the WhatsApp thread they already know instead of a
# cold email. Without this template that only works while their window is open;
# otherwise outreach falls back to email as before.
WHATSAPP_TEMPLATE_NEXT_CAMPAIGN=
# Deadline reminders, mirrored to WhatsApp from influence-stats's own email
# reminders (services/scheduler_service.py in the influence_bot repo). The bot
# calls /api/bot/creator-updates with event="deadline_reminder" (pre-deadline
# tiers: 3_days, 1_day) or "deadline_overdue" (post-deadline chase); this
# service delivers over the creator's open WhatsApp window and, when the
# window is shut, uses one of the templates below. Unset templates fall back
# to queuing until the window opens (same rule as every other kind).
WHATSAPP_TEMPLATE_DEADLINE_REMINDER=
WHATSAPP_TEMPLATE_DEADLINE_OVERDUE=
# How often the catch-up sweep runs (minutes, default 15; 0 disables it). It
# flushes updates that queued while a window was shut and asks newly-signed
# creators for the "Hi" that opens one.
CREATOR_UPDATES_SWEEP_MINUTES=
# How many delivery attempts a queued update gets before it's marked `failed`
# and stops being retried (default 8).
CREATOR_UPDATE_MAX_ATTEMPTS=
#
# Diagnose one creator's lane with
#   GET /api/debug/creator-updates?creatorId=123
# — subscription state, whether their window is open right now, and every update
# sent or still pending with the reason it hasn't gone out.
#
# The INFLUENCE Slack bot reports the events that drive this lane (draft
# submitted, approved, feedback, post link, deliverables complete) to
#   POST /api/bot/creator-updates   with x-bot-token: OUTREACH_BOT_TOKEN
# so set OUTREACH_BOT_TOKEN above and the matching OUTREACH_API_BASE /
# OUTREACH_BOT_TOKEN on the Influence_Bot service.
#
# --- Twilio (BSP alternative) ---------------------------------------------
# WhatsApp channel — Twilio (https://www.twilio.com/docs/whatsapp/api). Twilio
# needs BOTH the Account SID and the Auth Token: SID + Token authenticate the
# outbound Messages request via Basic Auth, and the Auth Token doubles as the
# HMAC key that verifies each inbound webhook's X-Twilio-Signature (no separate
# webhook secret). TWILIO_WHATSAPP_FROM is YOUR business's WhatsApp number in
# E.164 with the leading "+" (e.g. +18005551234); it's shown in the invite email
# AND sent as the `From` on every message (the code prefixes "whatsapp:").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Optional Twilio API base override (default https://api.twilio.com — only set
# for regional or private-network endpoints).
TWILIO_API_BASE=
# Optional override for the URL Twilio signs when POSTing to /webhook/whatsapp.
# Only needed if the reverse-proxy headers (X-Forwarded-Proto/-Host) don't
# reflect the exact URL configured in the Twilio console (custom path rewrite,
# non-standard proxy). Format: full public https URL of THIS outreach app.
TWILIO_WEBHOOK_URL=
# NOTE: no session-template fallback is wired in yet. A send outside Meta's 24h
# customer-service window will fail with a Twilio "outside-window" error
# (code 63016); the message can be retried once the creator messages us again.
# Wire a Twilio Content Template send in offerPortal/whatsapp.js to re-enable a
# template fallback here.

# iMessage channel — Linq Partner API v3 (https://linqapp.com). Sends blue-bubble
# iMessages: POST {IMESSAGE_API_URL} with Authorization: Bearer {IMESSAGE_API_KEY}
# and a chats/parts JSON body. Your SANDBOX token selects the sandbox environment
# (same base URL). Leave IMESSAGE_API_KEY blank to skip iMessage sends.
# IMESSAGE_API_URL defaults to Linq's /chats endpoint when unset.
IMESSAGE_API_URL=https://api.linqapp.com/api/partner/v3/chats
IMESSAGE_API_KEY=
# The Linq sender number outbound iMessages come from — E.164 with the leading
# "+" (your sandbox-assigned number). Required for sends, and also shown in the
# invite email so a creator knows what number to text.
IMESSAGE_FROM_NUMBER=
# Linq HMAC signing secret for the inbound webhook (POST /webhook/imessage). When
# set, inbound POSTs are signature-verified; leave blank to accept unsigned posts
# (sandbox). The verifier accepts both the Standard Webhooks and X-Linq-Signature
# schemes — confirm which your Linq dashboard uses.
IMESSAGE_WEBHOOK_SECRET=

# Offer economics. OFFER_CURRENCY is the currency offers are priced in (ISO
# 4217). OFFER_EXPIRY_DAYS is how long an offer stays open.
#
# Counter-offer CPM knobs (how a creator's Budget-decline counter-ask is judged,
# see offers.negotiateBudget):
#   COUNTER_CPM_TOLERANCE     — a counter within this many CPM of our offer is
#                               met at (roughly) their rate; above it we hold CPM
#                               by expanding deliverables instead. Default 1.5.
#   MAX_CPM_INCREASE_PCT      — the hard ceiling: a counter more than this
#                               fraction above the creator's established PRIOR-
#                               campaign CPM is declined outright (the standing
#                               offer stays live so they can still take it).
#                               Default 0.5 → 50% above prior CPM.
#   COUNTER_STRATEGY          — 'midpoint' (default) meets between our rate and
#                               theirs; 'match' counters at exactly their ask.
#   COUNTER_RATE_TOLERANCE_PCT— fallback rate tolerance when an offer has no
#                               impressions to compute CPM from. Default 0.15.
OFFER_CURRENCY=USD
# Days a fresh offer stays open — surfaced as the "Respond by …" / "open until …"
# date in the outreach email + WhatsApp copy (the offer portal itself no longer
# renders it, to avoid double-messaging a hard deadline once the creator's on
# the page). 4 days by default; a campaign that needs a longer window can raise
# this without touching code.
OFFER_EXPIRY_DAYS=4
COUNTER_CPM_TOLERANCE=1.5
MAX_CPM_INCREASE_PCT=0.5
COUNTER_STRATEGY=midpoint
COUNTER_RATE_TOLERANCE_PCT=0.15
# Schedule negotiation (a "Timing" decline): how soon a creator's proposed start
# date must be for us to accommodate it automatically — re-offer the same terms
# on their dates as a fresh portal offer. Beyond this the deal goes on hold for
# an admin schedule-counter instead of closing. Default 14 days.
SCHEDULE_THRESHOLD_DAYS=14

# New-vs-old segmentation cache TTL (ms). A creator's segment is re-checked
# against the Creator Database once it's older than this. Default 24h.
SEGMENT_TTL_MS=86400000
# How often the scheduler runs the segmentation sweep (minutes) so Used-creator
# marking + phone backfill happen without a dashboard load. TTL-gated by
# SEGMENT_TTL_MS, so a sweep with nothing due is cheap. Default 60.
SEGMENT_SWEEP_MINUTES=60
